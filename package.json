{
	"name": "n8n-nodes-velver",
	"version": "0.1.0",
	"description": "Run custom python code without limitations",
	"license": "MIT",
	"homepage": "",
	"keywords": [
		"n8n-community-node-package"
	],
	"author": {
		"name": "Velver Consulting",
		"email": "consulting@velver.mx"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/velverconsulting/n8n-nodes-velver-python.git"
	},
	"scripts": {
		"build": "n8n-node build & ssh root@100.82.138.91 \"rm -rf ~/n8n-docker/custom/n8n-nodes-velver/*\" & scp -r ./dist/* root@100.82.138.91:~/n8n-docker/custom/n8n-nodes-velver/ & ssh root@100.82.138.91 \"cd ~/n8n-docker && docker compose down && docker compose up -d --build\"",
		"update": "ssh root@100.82.138.91 \"cd ~/n8n-docker && docker compose build --pull n8n && docker compose up -d\"",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"credentials/VelverApi.credentials.js"
		],
		"nodes": [
			"nodes/VelverPython/VelverPython.node.js",
			"nodes/VelverGobierno/VelverGobierno.node.js",
			"nodes/VelverYolo/VelverYolo.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"@types/node": "^24.10.0",
		"@types/sharp": "^0.31.1",
		"@vercel/ncc": "^0.38.4",
		"eslint": "^9.39.1",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "^1.17.0"
	},
	"dependencies": {
		"axios": "^1.13.2",
		"fast-xml-parser": "^5.3.1",
		"file-type": "^16.5.3",
		"form-data": "^4.0.5",
		"onnxruntime-node": "^1.23.2",
		"sharp": "^0.34.5",
		"uuid": "^13.0.0"
	}
}
